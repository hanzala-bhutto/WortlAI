# WortlAI environment - copy to .env and fill in. All services are free tier.
# Every tunable lives here, not in source. Values below are the defaults we run
# with; the app refuses to start if one is missing.

# --- API keys ---
# Leaving a key blank is allowed: /health reports it as unconfigured and the
# related feature is unavailable. It is not a startup error.

# Groq (console.groq.com) - primary LLM + Whisper STT
GROQ_API_KEY=

# NVIDIA NIM (build.nvidia.com) - fallback LLM, vision extraction
NIM_API_KEY=

# Langfuse - traces, prompt management, evals.
# Self-hosted only, no cloud account. Point this at your local Langfuse and use
# the key pair from a Langfuse project dedicated to WortlAI, so a shared
# instance keeps this project's traces, prompts and datasets separate.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_USER_ID=hanzala

# --- Local services ---
QDRANT_URL=http://localhost:6333

# --- LLM provider endpoints ---
# OpenAI-compatible chat-completions base URLs. The provider layer posts to
# {BASE_URL}/chat/completions for both.
GROQ_BASE_URL=https://api.groq.com/openai/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Models and voices ---
# Swap any of these without touching code. The three LLM models form the
# fallback chain, tried in order: primary -> secondary (both Groq) -> fallback (NIM).
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_SECONDARY=llama-3.3-70b-versatile
LLM_MODEL_FALLBACK=meta/llama-3.3-70b-instruct
STT_MODEL=whisper-large-v3-turbo
TTS_VOICE=de-DE-KatjaNeural

# --- App ---
# Where the frontend runs. It uses 3001 because Langfuse holds 3000.
CORS_ORIGINS=["http://localhost:3001"]

# --- Tutor ---
# Which Langfuse prompt label the Tutor speaks with. Flip to "staging" to trial a
# new system prompt without a code change or a deploy.
TUTOR_PROMPT_LABEL=production
# Sampling temperature and the per-reply token ceiling (a cap, not a target - the
# guardrail that stops a runaway generation burning the free tier).
TUTOR_TEMPERATURE=0.6
TUTOR_MAX_TOKENS=320

# --- Corrector ---
# The async error analyst. Mirrors the Tutor knobs. Temperature 0 because error
# detection wants repeatable output, not variety.
CORRECTOR_PROMPT_LABEL=production
CORRECTOR_TEMPERATURE=0.0
CORRECTOR_MAX_TOKENS=512
# Staged-correction policy: "critical" surfaces only communication-breaking errors
# at the debrief (weeks 1-3, fluency before accuracy); switch to "minor" later to
# start debriefing the smaller slips too.
CORRECTOR_SEVERITY_THRESHOLD=critical

# --- Voice ---
# Guardrails for the voice loop (#3). A per-utterance audio byte ceiling (proxy for
# an audio-seconds cap, so a client can't ship huge blobs to the STT free tier) and
# a per-connection turn cap so one session can't loop forever burning requests.
MAX_UTTERANCE_BYTES=2000000
VOICE_MAX_TURNS=60
# TTS playback speed: the default when the client sends none, and the band a client
# rate is clamped to (1.0 = normal). Slow for early practice, up to slightly-fast.
VOICE_RATE_DEFAULT=1.0
VOICE_RATE_MIN=0.7
VOICE_RATE_MAX=1.2

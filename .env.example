# WortlAI environment - copy to .env and fill in (all free tier)

# Groq (console.groq.com) - primary LLM + Whisper STT
GROQ_API_KEY=

# NVIDIA NIM (build.nvidia.com) - fallback LLM, vision extraction, optional embeddings
NIM_API_KEY=

# Langfuse (cloud.langfuse.com) - traces, prompt management, evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local services
QDRANT_URL=http://localhost:6333

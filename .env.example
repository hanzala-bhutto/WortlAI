# WortlAI environment - copy to .env and fill in. All services are free tier.
# Every tunable lives here, not in source. Values below are the defaults we run
# with; the app refuses to start if one is missing.

# --- API keys ---
# Leaving a key blank is allowed: /health reports it as unconfigured and the
# related feature is unavailable. It is not a startup error.

# Groq (console.groq.com) - primary LLM + Whisper STT
GROQ_API_KEY=

# NVIDIA NIM (build.nvidia.com) - fallback LLM, vision extraction
NIM_API_KEY=

# Langfuse - traces, prompt management, evals.
# Self-hosted only, no cloud account. Point this at your local Langfuse and use
# the key pair from a Langfuse project dedicated to WortlAI, so a shared
# instance keeps this project's traces, prompts and datasets separate.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Local services ---
QDRANT_URL=http://localhost:6333

# --- Models and voices ---
# Swap any of these without touching code.
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_SECONDARY=llama-3.3-70b-versatile
STT_MODEL=whisper-large-v3-turbo
TTS_VOICE=de-DE-KatjaNeural

# --- App ---
# Where the frontend runs. It uses 3001 because Langfuse holds 3000.
CORS_ORIGINS=["http://localhost:3001"]
